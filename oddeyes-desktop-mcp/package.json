{
  "name": "oddeyes-desktop-mcp",
  "version": "1.0.0",
  "description": "MCP server that connects Claude Desktop to OddEyes.ai translation editor",
  "type": "module",
  "bin": {
    "oddeyes-desktop-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build": "npm run build:ts && npm run build:bundle",
    "prepublishOnly": "npm run build:ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "claude-desktop",
    "translation",
    "oddeyes"
  ],
  "author": "OddEyes.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hyunsang-coder/translation-editor",
    "directory": "oddeyes-desktop-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2"
  }
}
