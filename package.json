{
  "name": "integrated-translation-editor",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "node scripts/tauri-build.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ci:local": "npm run test:run && npm run test:e2e:web && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:tauri": "npm run test:run && npm run test:e2e && cargo test --manifest-path src-tauri/Cargo.toml && cargo check --release --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "npm run test:e2e:tauri",
    "test:e2e:tauri": "node scripts/tauri-smoke.mjs",
    "test:e2e:tauri:mcp:new-project": "node scripts/tauri-testing-mcp-new-project.mjs",
    "test:e2e:tauri:mcp:workflow": "node scripts/tauri-testing-mcp-workflow.mjs",
    "test:e2e:tauri:mcp:review-highlight": "node scripts/tauri-testing-mcp-review-highlight.mjs",
    "test:e2e:tauri:mcp:history-compare": "node scripts/tauri-testing-mcp-history-compare.mjs",
    "test:e2e:web": "playwright test -c playwright.web.config.ts",
    "test:e2e:web:ui": "playwright test -c playwright.web.config.ts --ui",
    "tauri-testing-mcp:build": "npm --prefix tauri-testing-mcp run build",
    "tauri-testing-mcp:dev": "npm --prefix tauri-testing-mcp run dev",
    "tauri-testing-mcp:start": "npm --prefix tauri-testing-mcp run start",
    "oddeyes-desktop-mcp:build": "npm --prefix oddeyes-desktop-mcp run build",
    "oddeyes-desktop-mcp:dev": "npm --prefix oddeyes-desktop-mcp run dev",
    "oddeyes-desktop-mcp:start": "npm --prefix oddeyes-desktop-mcp run start",
    "test:harness": "vite --open /test-harness.html --port 1421",
    "release:copy": "cp -r release/* ../oddeyes-release/ && cp src-tauri/target/release/bundle/dmg/*.dmg ../oddeyes-release/ && echo '✅ Copied to oddeyes-release'",
    "release:docs": "cp release/README.md release/CHANGELOG.md ../oddeyes-release/ && echo '✅ Docs copied'"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@headlessui/react": "^2.2.9",
    "@langchain/anthropic": "^1.3.10",
    "@langchain/core": "^1.1.8",
    "@langchain/mcp-adapters": "^1.1.1",
    "@langchain/openai": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@tiptap/core": "^2.10.4",
    "@tiptap/extension-document": "^2.10.4",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.1",
    "@tiptap/extension-paragraph": "^2.10.4",
    "@tiptap/extension-placeholder": "^2.27.1",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text": "^2.10.4",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.10.4",
    "@tiptap/react": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4",
    "@turbodocx/html-to-docx": "^1.20.1",
    "diff": "^8.0.2",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.3.1",
    "html2canvas": "^1.4.1",
    "i18next": "^25.7.3",
    "jspdf": "^4.1.0",
    "langchain": "^1.2.3",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.0.15",
    "react-rnd": "^10.5.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tiptap-markdown": "^0.8.10",
    "uuid": "^11.0.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
